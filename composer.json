{
    "name": "sitewarm/sdk",
    "description": "PHP client for the sitewarm API (pre-release)",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/sitewarm/sdk-php",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/psr7": "^2.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Sitewarm\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sitewarm\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
